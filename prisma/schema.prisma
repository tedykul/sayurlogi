// ============================================================
// Prisma schema — Coupon module
// ============================================================
// Backward compatible: existing User + Post models preserved.
// New models added: Coupon, CouponUsage, Product, Order.
// Coupon/CouponUsage are SayurLogi-compatible (same field names
// + types) so this module can be merged into the SayurLogi
// project later without schema conflicts.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Existing models (default scaffold — preserved for backward
// compatibility, do not modify).
// ------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Product — storefront catalog.
// ============================================================
// Sources:
//   1. Seed (demo products) — itemCode is null, published=true.
//   2. ERPNext sync — itemCode set (unique), erpSyncedAt tracks
//      last sync. Upsert keyed by itemCode so re-sync updates in
//      place without creating duplicates.
//
// ERPNext-sourced fields (overwritten on sync): name, description,
// category, price, unit, stock, image, emoji, oldPrice.
// image is rewritten to "/api/erp-image/..." proxy path so the
// storefront can serve ERPNext-hosted photos same-origin.
// ============================================================

model Product {
  id          String   @id @default(cuid())
  // ERPNext item_code (unique when set). Null for seed/demo products.
  itemCode    String?  @unique
  name        String
  description String   @default("")
  price       Int      // IDR, no decimals (matches SayurLogi pattern)
  oldPrice    Int?     // original price (for crossed-out display)
  category    String   @default("Umum")
  unit        String   @default("pcs") // ERPNext stock_uom
  image       String?
  emoji       String?  // fallback display when no image
  stock       Int      @default(0)
  published   Boolean  @default(true)
  erpSyncedAt DateTime? // null = local-only; set when synced from ERPNext
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([erpSyncedAt])
}

// ============================================================
// IntegrationConfig — DB-backed integration settings.
// ============================================================
// Stores ERPNext (and future: Midtrans, WhatsApp) connection
// settings so they can be edited via admin UI without restart.
// Priority: DB > env vars > empty.
// Secrets (isSecret=true) encrypted with AES-256-CBC (see
// lib/integration-config.ts). Keyed by string key (e.g.
// "erpnext_url", "erpnext_api_secret").
// ============================================================

model IntegrationConfig {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ============================================================
// Order — checkout record (minimal for coupon demo).
// ============================================================

model Order {
  id              String   @id @default(cuid())
  itemsJson       String   // snapshot of cart items
  subtotal        Int      // IDR
  shipping        Int      @default(0)
  discount        Int      @default(0) // discount applied (IDR)
  total           Int      // subtotal - discount + shipping
  customerName    String
  customerEmail   String?
  customerPhone   String
  customerAddress String   @default("")
  couponCode      String?  // snapshot of applied coupon code
  // ERPNext Sales Order name (e.g. "SO-2026-00001") when order was
  // pushed to ERPNext. Null = local-only (mock mode or sync failed).
  erpOrderName    String?
  status          String   @default("pending") // pending|paid|cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([couponCode])
  @@index([status])
  @@index([createdAt])
  @@index([erpOrderName])
}

// ============================================================
// Coupon — discount code with share + tracking + anti-abuse.
// ============================================================
// Field-compatible with SayurLogi's Coupon model (same names,
// types, defaults). Additional fields (batchId, clickCount,
// shareCount, printedAt, printedCount) extend the model for the
// new share-via-WA + PDF export + analytics flow without
// breaking SayurLogi's existing API consumers.
//
// type:        "percent" | "fixed" | "free_shipping"
// value:       percent (1-100) or IDR amount. Ignored for free_shipping.
// minOrder:    minimum subtotal (IDR). 0 = no minimum.
// maxUsage:    max total redemptions. 0 = unlimited.
// maxPerUser:  max redemptions per customer (email or phone). 0 = unlimited.
// usedCount:   denormalized count of CouponUsage rows (incremented on apply).
// scopeType:   "all" | "category" | "product"
// scopeValue:  category name or product id when scopeType != "all".
// batchId:     groups coupons created from the same generate-batch call.
// clickCount:  increments when ?coupon=CODE link is opened (track marketing reach).
// shareCount:  increments when admin clicks "Share WA" or "Copy link".
// printedAt:   last time PDF was exported (audit).
// printedCount: total PDF exports (audit).
// ============================================================

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String
  value       Int      @default(0)
  minOrder    Int      @default(0)
  maxUsage    Int      @default(0)
  maxPerUser  Int      @default(1)
  usedCount   Int      @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  active      Boolean  @default(true)
  scopeType   String   @default("all")
  scopeValue  String?
  note        String?

  // Share + tracking (new, SayurLogi-compatible extension)
  batchId     String?
  description String?
  clickCount  Int      @default(0)
  shareCount  Int      @default(0)
  printedAt   DateTime?
  printedCount Int     @default(0)

  usages      CouponUsage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([expiresAt])
  @@index([batchId])
}

// ============================================================
// CouponUsage — redemption log (one row per coupon application).
// ============================================================
// Tracks who used which coupon, when, and how much discount was
// applied. Used for:
//  - enforcing maxPerUser (count rows WHERE email=? OR phone=?)
//  - analytics (total redeemed, by customer, by date)
//  - audit trail (snapshot of code in case coupon is deleted)
//
// email/phone are nullable because guest checkout may omit one.
// discount is a snapshot in IDR (so historical orders show the
// correct amount even if the coupon value changes later).
// ============================================================

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  code      String   // snapshot of coupon code at time of use
  orderId   String?
  email     String?
  phone     String?
  discount  Int
  usedAt    DateTime @default(now())

  @@index([couponId])
  @@index([email])
  @@index([phone])
  @@index([orderId])
}
