From 2f8687a2a7a190550d58c06d6a6bcabeccd1a528 Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Sat, 7 Nov 2026 12:22:53 +0000
Subject: [PATCH 2/2] fix(google-auth): watchdog polling + improved
 loading/error UI
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Add waitForGisApi polling (300ms interval, 3s timeout) to detect
  when window.google.accounts.id is actually ready — fixes silent
  loading-forever when script.onload fires but API not yet set
- Reduce load timeout 15s → 10s for snappier error feedback
- Add slow hint after 4s of loading ("Memuat lebih lama dari biasanya")
- Improve error UI: clearer message + hint about Google Cloud Console
  origins + retry button
- Skip script append if window.google already available (case: user
  opens dialog, closes, reopens)
---
 .../grocery/google-signin-button.tsx          | 114 +++++++++++++++---
 1 file changed, 95 insertions(+), 19 deletions(-)

diff --git a/src/components/grocery/google-signin-button.tsx b/src/components/grocery/google-signin-button.tsx
index 82a9bfc..c8e3d90 100755
--- a/src/components/grocery/google-signin-button.tsx
+++ b/src/components/grocery/google-signin-button.tsx
@@ -43,30 +43,86 @@ let gisLoadPromise: Promise<void> | null = null;
 // Batas waktu memuat script GIS. Jaringan terblokir/buruk bisa
 // menggantung request tanpa pernah memicu onerror — tanpa timeout,
 // tombol menampilkan spinner selamanya.
-const GIS_LOAD_TIMEOUT_MS = 15000;
+const GIS_LOAD_TIMEOUT_MS = 10000;
+
+/**
+ * Cek apakah GIS API sudah siap di window.google.accounts.id.
+ * Kadang script.onload fires TAPI window.google.accounts.id belum
+ * siap (race condition Google). Polling untuk memastikan API benar-benar
+ * siap sebelum declare "ready".
+ */
+function isGisApiReady(): boolean {
+  return typeof window !== "undefined" && !!window.google?.accounts?.id;
+}
+
+/**
+ * Tunggu GIS API siap dengan polling. Resolve begitu window.google.accounts.id
+ * tersedia, atau reject kalau timeout. Dipakai sebagai watchdog setelah
+ * script.onload fire — supaya kita tidak declare "ready" sebelum API siap.
+ */
+function waitForGisApi(timeoutMs: number): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (isGisApiReady()) return resolve();
+    const start = Date.now();
+    const interval = window.setInterval(() => {
+      if (isGisApiReady()) {
+        window.clearInterval(interval);
+        resolve();
+        return;
+      }
+      if (Date.now() - start > timeoutMs) {
+        window.clearInterval(interval);
+        reject(new Error("GIS API tidak siap dalam waktu yang wajar."));
+      }
+    }, 100);
+  });
+}
 
 function loadGisScript(): Promise<void> {
-  if (gisLoaded) return Promise.resolve();
+  if (gisLoaded && isGisApiReady()) return Promise.resolve();
   if (gisLoadPromise) return gisLoadPromise;
 
   const attempt = new Promise<void>((resolve, reject) => {
+    // Kalau GIS sudah pernah dimuat di session lain (misal user
+    // buka dialog, tutup, buka lagi), window.google mungkin sudah
+    // ada — skip append script baru.
+    if (isGisApiReady()) {
+      gisLoaded = true;
+      resolve();
+      return;
+    }
+
     const script = document.createElement("script");
     script.src = GIS_SCRIPT_URL;
     script.async = true;
     script.defer = true;
     const timer = window.setTimeout(() => {
       script.remove();
-      reject(new Error("Timeout memuat Google Identity Services (15s)."));
+      reject(new Error("Timeout memuat Google Identity Services (10s)."));
     }, GIS_LOAD_TIMEOUT_MS);
     script.onload = () => {
       window.clearTimeout(timer);
-      gisLoaded = true;
-      resolve();
+      // Jangan langsung resolve — tunggu API siap (race condition fix).
+      // Google set window.google.accounts.id secara async di beberapa
+      // browser; resolve begitu siap, atau watchdog timeout.
+      waitForGisApi(3000)
+        .then(() => {
+          gisLoaded = true;
+          resolve();
+        })
+        .catch(() => {
+          // Script loaded TAPI window.google.accounts.id belum ada
+          // setelah 3s polling — kemungkinan CSP block atau script
+          // corrupt. Treat sebagai gagal.
+          script.remove();
+          gisLoaded = false;
+          reject(new Error("GIS script loaded tapi API tidak terdeteksi (kemungkinan CSP/origin block)."));
+        });
     };
     script.onerror = () => {
       window.clearTimeout(timer);
       script.remove();
-      reject(new Error("Gagal memuat Google Identity Services."));
+      reject(new Error("Gagal memuat Google Identity Services (script.onerror)."));
     };
     document.head.appendChild(script);
   });
@@ -84,6 +140,8 @@ export function GoogleSignInButton({ clientId, onSuccess, onError }: GoogleSignI
   const [loading, setLoading] = useState(false);
   const [gisReady, setGisReady] = useState(false);
   const [gisError, setGisError] = useState(false);
+  // slowHint: true kalau loading > 4s — beri tahu user ada masalah
+  const [slowHint, setSlowHint] = useState(false);
   const [retryNonce, setRetryNonce] = useState(0);
   const buttonRef = useRef<HTMLDivElement>(null);
 
@@ -91,18 +149,27 @@ export function GoogleSignInButton({ clientId, onSuccess, onError }: GoogleSignI
   useEffect(() => {
     let cancelled = false;
     setGisError(false);
+    setSlowHint(false);
+    // Setelah 4s masih loading → tampilkan hint (jangan tunggu 10s)
+    const slowTimer = window.setTimeout(() => {
+      if (!cancelled) setSlowHint(true);
+    }, 4000);
     loadGisScript()
       .then(() => {
         if (cancelled) return;
+        window.clearTimeout(slowTimer);
+        setSlowHint(false);
         setGisReady(true);
       })
       .catch((err) => {
         if (cancelled) return;
+        window.clearTimeout(slowTimer);
         console.warn("[GoogleSignInButton] GIS load failed:", err);
         setGisError(true);
       });
     return () => {
       cancelled = true;
+      window.clearTimeout(slowTimer);
     };
   }, [retryNonce]);
 
@@ -163,26 +230,35 @@ export function GoogleSignInButton({ clientId, onSuccess, onError }: GoogleSignI
 
   if (gisError) {
     return (
-      <div
-        role="button"
-        tabIndex={0}
+      <button
+        type="button"
         onClick={() => setRetryNonce((n) => n + 1)}
-        onKeyDown={(e) => {
-          if (e.key === "Enter" || e.key === " ") setRetryNonce((n) => n + 1);
-        }}
-        className="flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-full border border-border bg-muted/30 text-sm text-muted-foreground transition-colors hover:bg-muted/60"
+        className="flex w-full flex-col items-center gap-1 rounded-xl border border-amber-300/50 bg-amber-50 p-3 text-center text-xs text-amber-700 transition-colors hover:bg-amber-100 dark:border-amber-700/50 dark:bg-amber-950/30 dark:text-amber-300"
       >
-        <AlertCircle className="h-4 w-4 shrink-0" />
-        Gagal memuat Google. Ketuk untuk coba lagi.
-      </div>
+        <span className="flex items-center gap-1.5 font-medium">
+          <AlertCircle className="h-4 w-4 shrink-0" />
+          Gagal memuat Google Sign-In
+        </span>
+        <span className="text-[10px] leading-tight opacity-80">
+          Periksa koneksi internet + pastikan origin sudah terdaftar di Google Cloud Console.
+        </span>
+        <span className="mt-1 text-[10px] font-semibold underline">Ketuk untuk coba lagi</span>
+      </button>
     );
   }
 
   if (!gisReady) {
     return (
-      <div className="flex h-11 items-center justify-center gap-2 rounded-full border border-border bg-muted/30 text-sm text-muted-foreground">
-        <Loader2 className="h-4 w-4 animate-spin" />
-        Memuat Google...
+      <div className="flex flex-col items-center gap-1 rounded-xl border border-border bg-muted/30 px-3 py-2.5 text-sm text-muted-foreground">
+        <div className="flex items-center gap-2">
+          <Loader2 className="h-4 w-4 animate-spin" />
+          Memuat Google...
+        </div>
+        {slowHint && (
+          <p className="text-[10px] leading-tight text-amber-600 dark:text-amber-400">
+            Memuat lebih lama dari biasanya. Pastikan koneksi internet stabil.
+          </p>
+        )}
       </div>
     );
   }
-- 
