# ============================================================
# SayurLogi — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file (it's gitignored).
# ============================================================

# Database (SQLite — file path must be absolute)
DATABASE_URL=file:/absolute/path/to/db/custom.db

# NextAuth.js (used for admin auth)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# Admin login (legacy password gate — for dev/scripts only)
# Leave empty in production to disable password-gate mode
# and force email+password via User table.
ADMIN_PASSWORD=

# Google OAuth (customer sign-in)
# Get from: https://console.cloud.google.com → Credentials → OAuth client ID
GOOGLE_CLIENT_ID=

# ERPNext integration (optional)
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Midtrans payment gateway (optional)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Optional: Google Maps for delivery
GOOGLE_MAPS_API_KEY=
