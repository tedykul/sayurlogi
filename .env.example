# ============================================================
# SayurLogi — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file (it's gitignored).
# ============================================================

# Database (SQLite — file path must be absolute)
DATABASE_URL=file:/absolute/path/to/db/custom.db

# NextAuth.js (used for admin auth)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# Admin login (legacy password gate — for dev/scripts only)
# Leave empty in production to disable password-gate mode
# and force email+password via User table.
ADMIN_PASSWORD=

# Google OAuth (customer sign-in)
# Get from: https://console.cloud.google.com → Credentials → OAuth client ID
GOOGLE_CLIENT_ID=

# ERPNext integration (optional)
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Midtrans payment gateway (optional)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Optional: Google Maps for delivery
GOOGLE_MAPS_API_KEY=

# ============================================================
# SMTP — Transactional email (password reset, order confirmations)
# ============================================================
# When SMTP_HOST is set, forgot-password akan kirim email beneran
# ke user. Kalau tidak diset, sistem fallback ke ContactMessage
# table (admin bisa manual send) + console.log.
#
# Provider options (pilih salah satu):
#   Gmail:       smtp.gmail.com:587 (pakai App Password, bukan password biasa)
#   Mailgun:    smtp.mailgun.org:587 (free tier: 5k emails/bulan)
#   SendGrid:   smtp.sendgrid.net:587 (free tier: 100 emails/hari)
#   Amazon SES: email-smtp.[region].amazonaws.com:587 (cheapest for high volume)
#   Zoho Mail:  smtp.zoho.com:587 (free tier: 5 users, 5GB each)
#
# Gmail App Password setup:
#   1. Enable 2FA di https://myaccount.google.com/security
#   2. Generate App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-char app password (e.g., "abcd efgh ijkl mnop")
#      as SMTP_PASS (without spaces)
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@sayurlogi.com
SMTP_FROM_NAME=SayurLogi
