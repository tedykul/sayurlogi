# See https://help.github.com/articles/ignoring-files/ for more information.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# Sandbox AI skill files — not part of the application.
/skills/

# Runtime database — each deployment (sandbox/VPS) keeps its own copy.
# NEVER commit: overwriting the VPS production DB via git pull = data loss.
db/*.db
db/*.db-journal
/db/backups/

# Sandbox conversation artifacts (tool transcripts, pasted content, screenshots).
# Already excluded from the deploy tarball (see src/app/api/deploy/download).
/tool-results/
/upload/

# Sandbox dev-server runtime state
.zscripts/dev.pid
